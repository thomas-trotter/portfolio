{
  "compilerOptions": {
    // Language & environment
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",

    // Modules
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,

    // Type checking
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noEmit": true,

    // Build
    "incremental": true,
    "plugins": [{ "name": "next" }],

    // Path aliases
    "paths": {
      "@/*": ["./src/*"],
      "@/.velite": ["./.velite"],
      "@/.velite/*": ["./.velite/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
